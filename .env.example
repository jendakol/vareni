# Required
ANTHROPIC_API_KEY=sk-ant-...

# OIDC (Keycloak) — all four are required, the app refuses to log anyone in without them
OIDC_ISSUER_URL=https://keycloak.example.com/realms/master
OIDC_CLIENT_ID=vareni
OIDC_CLIENT_SECRET=change-me
OIDC_REDIRECT_URI=https://vareni.example.com/api/auth/callback
#OIDC_POST_LOGOUT_REDIRECT_URI=https://vareni.example.com/
#OIDC_REQUIRED_ROLE=vareni
#OIDC_ROLE_CLAIM=roles
#SESSION_TTL_HOURS=720
# Local plain-HTTP development only (cookie without __Host- prefix and Secure flag)
#ENVIRONMENT=local
#COOKIE_SECURE=false

# Database — Docker Compose sets this automatically, only needed for standalone deployment
#DATABASE_URL=postgresql://cooking:cooking@localhost:5432/cookingapp

# Optional
BASE_URL=http://localhost:8080

# Recipe discovery (optional — requires ONNX model, see README)
#EMBEDDING_MODEL_DIR=./models/all-MiniLM-L6-v2
#DISCOVERY_ENABLED=true

# Log API token (optional — enables POST /api/log for Home Assistant)
#LOG_API_TOKEN=

# Metrics — refresh interval for the recipes_total gauge (DB COUNT(*) cadence)
#METRICS_GAUGE_REFRESH_SECS=60
